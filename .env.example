# ============================================================================
# TeamLens Backend - Environment Variables Example
# Configuración para sistema de colas distribuido con Celery
# ============================================================================

# ============================================================================
# CONFIGURACIÓN DE APLICACIÓN
# ============================================================================
NODE_ENV=development
PORT=3000
JWT_SECRET=your_super_secure_jwt_secret_here_change_in_production
JWT_ALGORITHM=HS256

# ============================================================================
# CONFIGURACIÓN DE MONGODB
# ============================================================================
MONGODB_URI=mongodb://localhost:27017/test
# Para MongoDB Atlas (producción):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/teamlens?retryWrites=true&w=majority

# ============================================================================
# CONFIGURACIÓN DE REDIS (CELERY MESSAGE BROKER)
# ============================================================================

# Redis local (desarrollo)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=teamlens_redis_secure_password_2024

# URLs completas de Redis
REDIS_URL=redis://:teamlens_redis_secure_password_2024@localhost:6379/0
REDIS_RESULT_BACKEND=redis://:teamlens_redis_secure_password_2024@localhost:6379/1

# Configuración específica por base de datos
REDIS_BROKER_DB=0      # Base de datos para mensajes de Celery
REDIS_RESULT_DB=1      # Base de datos para resultados de tareas

# Para AWS ElastiCache (producción):
# REDIS_HOST=your-elasticache-cluster.xxxxx.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_URL=redis://your-elasticache-cluster.xxxxx.cache.amazonaws.com:6379/0
# REDIS_RESULT_BACKEND=redis://your-elasticache-cluster.xxxxx.cache.amazonaws.com:6379/1

# ============================================================================
# CONFIGURACIÓN DE CELERY
# ============================================================================

# Configuración del worker
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=50

# Configuración de timeouts (en segundos)
CELERY_SOFT_TIME_LIMIT=300    # 5 minutos
CELERY_TIME_LIMIT=600         # 10 minutos

# ============================================================================
# CONFIGURACIÓN DE FLOWER (MONITOREO)
# ============================================================================

# Credenciales de Flower
FLOWER_USER=admin
FLOWER_PASSWORD=flower123
FLOWER_BASIC_AUTH=admin:flower123

# ============================================================================
# CONFIGURACIÓN DE REDIS COMMANDER (DESARROLLO)
# ============================================================================
REDIS_COMMANDER_PASSWORD=admin123

# ============================================================================
# CONFIGURACIÓN AWS (PRODUCCIÓN)
# ============================================================================

# Región AWS
AWS_REGION=us-east-1

# ElastiCache configuración
AWS_ELASTICACHE_CLUSTER_ID=teamlens-redis-cluster
AWS_ELASTICACHE_NODE_TYPE=cache.t3.micro

# ECS/EC2 configuración
AWS_ECS_CLUSTER=teamlens-cluster
AWS_ECS_SERVICE=teamlens-backend

# ============================================================================
# CONFIGURACIÓN DE LOGGING
# ============================================================================

# Nivel de logging
LOG_LEVEL=info

# Para AWS CloudWatch
AWS_CLOUDWATCH_LOG_GROUP=teamlens-backend
AWS_CLOUDWATCH_LOG_STREAM=celery-workers

# ============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================================================

# CORS origins permitidos (separados por coma)
CORS_ORIGINS=http://localhost:4200,https://your-domain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000    # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100    # 100 requests por ventana

# ============================================================================
# CONFIGURACIÓN DE EMAIL (para notificaciones)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@teamlens.com

# ============================================================================
# CONFIGURACIÓN DE DESARROLLO
# ============================================================================

# Debug flags
DEBUG_CELERY=false
DEBUG_REDIS=false
DEBUG_ALGORITHM=false

# Hot reload
HOT_RELOAD=true

# ============================================================================
# CONFIGURACIÓN DE TESTING
# ============================================================================
TEST_MONGODB_URI=mongodb://localhost:27017/test_teamlens
TEST_REDIS_URL=redis://localhost:6379/15

# ============================================================================
# NOTAS DE CONFIGURACIÓN
# ============================================================================

# 1. Para desarrollo local:
#    - Asegúrate de que Redis esté ejecutándose: docker-compose -f docker-compose.redis.yml up -d
#    - Usa las configuraciones por defecto de localhost
#    - Las credenciales pueden ser simples para desarrollo

# 2. Para producción AWS:
#    - Cambia todas las URLs de Redis por ElastiCache
#    - Usa secretos de AWS Secrets Manager para credenciales
#    - Configura encryption in-transit para Redis
#    - Usa variables de entorno del contenedor ECS

# 3. Seguridad:
#    - NUNCA commits este archivo con credenciales reales
#    - Usa AWS Secrets Manager o similar en producción
#    - Rota regularmente las credenciales de Redis y MongoDB 
# ============================================================================
# TeamLens Backend - Environment Variables Example
# Configuración COMPLETA para desarrollo y producción
# ============================================================================

# ============================================================================
# CONFIGURACIÓN DE APLICACIÓN BÁSICA
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# CONFIGURACIÓN JWT (CRÍTICO - EL SISTEMA NO FUNCIONA SIN ESTO)
# ============================================================================
JWT_SECRET=teamlens_super_secure_jwt_secret_key_change_in_production_2024
JWT_ALGORITHM=HS256

# ============================================================================
# CONFIGURACIÓN DE MONGODB (CRÍTICO)
# ============================================================================
# Para desarrollo local
MONGO_URI=mongodb://localhost:27017/teamlens
DB_NAME=teamlens

# Para MongoDB Atlas (producción):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/teamlens?retryWrites=true&w=majority
# DB_NAME=teamlens

# ============================================================================
# CONFIGURACIÓN DE REDIS (PARA CELERY - OPCIONAL SI NO USAS ALGORITMOS)
# ============================================================================
# Redis local (desarrollo)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=teamlens_redis_secure_password_2024
REDIS_BROKER_DB=0
REDIS_RESULT_DB=1

# Para AWS ElastiCache (producción):
# REDIS_HOST=your-elasticache-cluster.xxxxx.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-secure-password

# ============================================================================
# ✨ CONFIGURACIÓN DE EMAILS PROFESIONALES ✨ (NUEVA FUNCIONALIDAD)
# ============================================================================
# URL del Frontend (CRÍTICO para que los enlaces funcionen)
FRONTEND_URL=http://localhost:4200

# Configuración SMTP
EMAIL_USER=teamlens.app@gmail.com
EMAIL_PASSWORD=your-email-app-password-here

# ============================================================================
# CONFIGURACIÓN DE COOKIES Y SESIONES (CRÍTICO)
# ============================================================================
COOKIE_SECRET=teamlens_cookie_secret_key_change_in_production_2024

# ============================================================================
# CONFIGURACIÓN DE CUESTIONARIOS (OPCIONAL)
# ============================================================================
# ID del cuestionario BELBIN (si usas uno específico)
BELBIN_QUESTIONNAIRE_ID=your-belbin-questionnaire-id-here

# ============================================================================
# CONFIGURACIÓN ADICIONAL
# ============================================================================
# Variable para endpoint de environment
ENVIROMENT=development

# ============================================================================
# INSTRUCCIONES PARA USAR ESTE ARCHIVO:
# ============================================================================
# 1. Copia este archivo como .env (sin .example)
# 2. Para desarrollo: Usa los valores por defecto
# 3. Para producción: Cambia TODOS los valores marcados como "change_in_production"
# 4. NUNCA subas el archivo .env real a Git (debe estar en .gitignore)

# ============================================================================
# CONFIGURACIÓN MÍNIMA PARA QUE FUNCIONE EN DESARROLLO:
# ============================================================================
# JWT_SECRET=cualquier-texto-largo-aqui
# JWT_ALGORITHM=HS256
# MONGO_URI=mongodb://localhost:27017/teamlens
# DB_NAME=teamlens
# COOKIE_SECRET=cualquier-texto-largo-aqui
# FRONTEND_URL=http://localhost:4200
# EMAIL_USER=teamlens.app@gmail.com
# EMAIL_PASSWORD=wobx oabi gxiw nlco

# ============================================================================
# PARA PRODUCCIÓN, CAMBIA ESTOS VALORES:
# ============================================================================
# NODE_ENV=production
# JWT_SECRET=un-secreto-muy-seguro-y-único
# MONGO_URI=tu-mongodb-de-producción
# COOKIE_SECRET=otro-secreto-muy-seguro
# FRONTEND_URL=https://tu-dominio-real.com
# EMAIL_USER=tu-email-real@tudominio.com
# EMAIL_PASSWORD=tu-password-real-de-email